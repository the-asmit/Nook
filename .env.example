# Nook development environment.
#
# `make env` (run automatically by dev-up and run-server) copies this file to
# .env, filling every __GENERATED_SECRET__ with a fresh random value and every
# __BCRYPT:NAME__ with a bcrypt hash of NAME. When this file gains variables,
# `make env` appends them to an existing .env without touching its values.
# .env is git-ignored; never commit it. Values may reference earlier
# variables as ${NAME}; docker compose and the Makefile (which sources this
# file with sh) both expand them.

# ---------------------------------------------------------------------------
# Development stack (deploy/compose/docker-compose.dev.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=nook
POSTGRES_PASSWORD=__GENERATED_SECRET__
POSTGRES_DB=nook
# Host port the Postgres container is published on (127.0.0.1 only).
POSTGRES_PORT=5432

REDIS_PASSWORD=__GENERATED_SECRET__
REDIS_PORT=6379

# MinIO is the development stand-in for S3-compatible object storage
# (Cloudflare R2 in production). Nook does not use it yet.
MINIO_ROOT_USER=nook
MINIO_ROOT_PASSWORD=__GENERATED_SECRET__
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Dex: development-only OpenID Connect provider (deploy/compose/dex).
# Sign in at http://localhost:8080 as one of these static users, with the
# generated password below:
#   alice@nook.test       allowed domain and bootstrap admin
#   bob@partner.test      other domain: needs an invitation
#   mallory@outside.test  other domain: always refused
DEX_PORT=5556
DEX_NOOK_CLIENT_SECRET=__GENERATED_SECRET__
DEX_ALICE_PASSWORD=__GENERATED_SECRET__
DEX_ALICE_PASSWORD_HASH=__BCRYPT:DEX_ALICE_PASSWORD__
DEX_BOB_PASSWORD=__GENERATED_SECRET__
DEX_BOB_PASSWORD_HASH=__BCRYPT:DEX_BOB_PASSWORD__
DEX_MALLORY_PASSWORD=__GENERATED_SECRET__
DEX_MALLORY_PASSWORD_HASH=__BCRYPT:DEX_MALLORY_PASSWORD__

# ---------------------------------------------------------------------------
# nook-server
#
# Any NOOK_X may instead be given as NOOK_X_FILE=/path/to/file; the file's
# contents become the value (for Docker/Kubernetes secrets).
# Durations use Go syntax: 500ms, 5s, 2m, 1h.
# ---------------------------------------------------------------------------

# Required. development | staging | production. Outside development, TLS is
# mandatory for HTTP, Postgres, Redis and the OIDC issuer, and Gin runs in
# release mode.
NOOK_ENV=development

# Required. The URL people open in their browser (scheme://host[:port]).
# Cookies, CSRF checks, the OIDC redirect URL and the device-login URL derive
# from it. http:// is accepted only for localhost in development.
NOOK_PUBLIC_URL=http://localhost:8080

# Minimum log level: debug | info | warn | error. Default: info.
NOOK_LOG_LEVEL=debug

# HTTP listen address. Default: :8080 (all interfaces, used in containers).
NOOK_HTTP_ADDR=127.0.0.1:8080
# Time allowed to read request headers (slow-loris protection). Default: 5s.
NOOK_HTTP_READ_HEADER_TIMEOUT=5s
# Time allowed to read the whole request. Default: 15s.
NOOK_HTTP_READ_TIMEOUT=15s
# Time allowed to write the response. Default: 30s.
NOOK_HTTP_WRITE_TIMEOUT=30s
# Keep-alive idle timeout. Default: 60s.
NOOK_HTTP_IDLE_TIMEOUT=60s
# Deadline on each request's context; must be below the write timeout. Default: 20s.
NOOK_HTTP_REQUEST_TIMEOUT=20s
# How long in-flight requests may run after SIGTERM. Default: 20s.
NOOK_HTTP_SHUTDOWN_TIMEOUT=20s
# Largest accepted request body in bytes (max 64 MiB). Default: 1048576 (1 MiB).
NOOK_HTTP_MAX_BODY_BYTES=1048576
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For. Default: none.
NOOK_HTTP_TRUSTED_PROXIES=
# PEM certificate and key; set both to serve HTTPS (required outside development).
NOOK_HTTP_TLS_CERT_PATH=
NOOK_HTTP_TLS_KEY_PATH=

# Required. Outside development use sslmode=verify-full.
NOOK_POSTGRES_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
# Pool limits and timeouts. Defaults: 10, 1, 30m, 5m, 30s, 5s.
NOOK_POSTGRES_MAX_CONNS=10
NOOK_POSTGRES_MIN_CONNS=1
NOOK_POSTGRES_MAX_CONN_LIFETIME=30m
NOOK_POSTGRES_MAX_CONN_IDLE_TIME=5m
NOOK_POSTGRES_HEALTH_CHECK_PERIOD=30s
NOOK_POSTGRES_CONNECT_TIMEOUT=5s

# Required. Outside development use the rediss:// (TLS) scheme.
NOOK_REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}/0
# Client timeouts and pool size. Defaults: 5s, 3s, 3s, 10.
NOOK_REDIS_DIAL_TIMEOUT=5s
NOOK_REDIS_READ_TIMEOUT=3s
NOOK_REDIS_WRITE_TIMEOUT=3s
NOOK_REDIS_POOL_SIZE=10

# Outside development, allow Postgres/Redis without TLS when every host they
# name is internal (Unix socket, loopback, RFC 1918/ULA address, or a
# single-label name such as a Docker service). Logged as a warning at startup.
# Default: false.
NOOK_ALLOW_PLAINTEXT_INTERNAL=false

# --- Sign-in (OpenID Connect) ---
# Required. The provider's issuer URL. Google: https://accounts.google.com
NOOK_OIDC_ISSUER_URL=http://localhost:${DEX_PORT}/dex
# Required. OAuth client credentials registered with the provider.
NOOK_OIDC_CLIENT_ID=nook-dev
NOOK_OIDC_CLIENT_SECRET=${DEX_NOOK_CLIENT_SECRET}
# Redirect URL registered with the provider. Default: NOOK_PUBLIC_URL/auth/callback.
NOOK_OIDC_REDIRECT_URL=
# Comma-separated scopes; must include openid and email. Default: openid,email,profile.
NOOK_OIDC_SCOPES=openid,email,profile
# Label of the sign-in button. Default: single sign-on.
NOOK_OIDC_PROVIDER_NAME="Dex (development)"
# Timeout for each request to the provider. Default: 10s.
NOOK_OIDC_HTTP_TIMEOUT=10s
# Who may create an account (at least one of the two must be set):
# people whose email domain is listed (exact match, comma-separated) ...
NOOK_ALLOWED_EMAIL_DOMAINS=nook.test
# ... and these addresses, who also become instance administrators.
# Anyone else needs an open invitation to a workspace.
NOOK_BOOTSTRAP_ADMIN_EMAILS=alice@nook.test

# --- Sessions, invitations and CLI login ---
# Browser session ends after this much inactivity. Default: 24h.
NOOK_SESSION_IDLE_TIMEOUT=24h
# ... and at the latest this long after sign-in. Default: 168h (7 days).
NOOK_SESSION_ABSOLUTE_TIMEOUT=168h
# Workspace invitations stay open this long. Default: 168h.
NOOK_INVITATION_TTL=168h
# `nook login` codes expire after this long. Default: 10m.
NOOK_DEVICE_CODE_TTL=10m
# Minimum interval between CLI polls. Default: 5s.
NOOK_DEVICE_POLL_INTERVAL=5s
# Lifetime of API tokens issued to the CLI by `nook login`. Default: 2160h (90 days).
NOOK_CLI_TOKEN_TTL=2160h

# Per-dependency timeout for GET /readyz; below the request timeout. Default: 2s.
NOOK_READINESS_TIMEOUT=2s
# How long startup waits for Postgres, Redis and the OIDC provider. Default: 30s.
NOOK_STARTUP_TIMEOUT=30s
# Bound on waiting for the migration lock plus applying migrations. Default: 2m.
NOOK_MIGRATION_TIMEOUT=2m
