# Nook development environment.
#
# `make env` (run automatically by dev-up and run-server) copies this file to
# .env, filling every __GENERATED_SECRET__ with a fresh random value and every
# __BCRYPT:NAME__ with a bcrypt hash of NAME. When this file gains variables,
# `make env` appends them to an existing .env without touching its values.
# .env is git-ignored; never commit it. Values may reference earlier
# variables as ${NAME}; docker compose and the Makefile (which sources this
# file with sh) both expand them.

# ---------------------------------------------------------------------------
# Development stack (deploy/compose/docker-compose.dev.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=nook
POSTGRES_PASSWORD=__GENERATED_SECRET__
POSTGRES_DB=nook
# Host port the Postgres container is published on (127.0.0.1 only).
POSTGRES_PORT=5432

REDIS_PASSWORD=__GENERATED_SECRET__
REDIS_PORT=6379

# MinIO is the development stand-in for S3-compatible object storage
# (Cloudflare R2 in production): source archives, build logs and the
# registry's images. `make dev-up` creates the buckets nook and nook-registry.
MINIO_ROOT_USER=nook
MINIO_ROOT_PASSWORD=__GENERATED_SECRET__
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# The private image registry (CNCF Distribution, deploy/compose/registry),
# published on 127.0.0.1 only. Its TLS certificate comes from Nook's CA
# (`make dev-up` issues it into .nook-dev/registry).
REGISTRY_PORT=5000
# The registry container runs as you, so it can read its key file.
NOOK_DEV_UID=__UID__
NOOK_DEV_GID=__GID__

# Dex: development-only OpenID Connect provider (deploy/compose/dex).
# Sign in at http://localhost:8080 as one of these static users, with the
# generated password below:
#   alice@nook.test       allowed domain and bootstrap admin
#   bob@partner.test      other domain: needs an invitation
#   mallory@outside.test  other domain: always refused
DEX_PORT=5556
DEX_NOOK_CLIENT_SECRET=__GENERATED_SECRET__
DEX_ALICE_PASSWORD=__GENERATED_SECRET__
DEX_ALICE_PASSWORD_HASH=__BCRYPT:DEX_ALICE_PASSWORD__
DEX_BOB_PASSWORD=__GENERATED_SECRET__
DEX_BOB_PASSWORD_HASH=__BCRYPT:DEX_BOB_PASSWORD__
DEX_MALLORY_PASSWORD=__GENERATED_SECRET__
DEX_MALLORY_PASSWORD_HASH=__BCRYPT:DEX_MALLORY_PASSWORD__

# ---------------------------------------------------------------------------
# nook-server
#
# Any NOOK_X may instead be given as NOOK_X_FILE=/path/to/file; the file's
# contents become the value (for Docker/Kubernetes secrets).
# Durations use Go syntax: 500ms, 5s, 2m, 1h.
# ---------------------------------------------------------------------------

# Required. development | staging | production. Outside development, TLS is
# mandatory for HTTP, Postgres, Redis and the OIDC issuer, and Gin runs in
# release mode.
NOOK_ENV=development

# Required. The URL people open in their browser (scheme://host[:port]).
# Cookies, CSRF checks, the OIDC redirect URL and the device-login URL derive
# from it. http:// is accepted only for localhost in development.
NOOK_PUBLIC_URL=http://localhost:8080

# Minimum log level: debug | info | warn | error. Default: info.
NOOK_LOG_LEVEL=debug

# HTTP listen address. Default: :8080 (all interfaces, used in containers).
NOOK_HTTP_ADDR=127.0.0.1:8080
# Time allowed to read request headers (slow-loris protection). Default: 5s.
NOOK_HTTP_READ_HEADER_TIMEOUT=5s
# Time allowed to read the whole request. Default: 15s.
NOOK_HTTP_READ_TIMEOUT=15s
# Time allowed to write the response. Default: 30s.
NOOK_HTTP_WRITE_TIMEOUT=30s
# Keep-alive idle timeout. Default: 60s.
NOOK_HTTP_IDLE_TIMEOUT=60s
# Deadline on each request's context; must be below the write timeout. Default: 20s.
NOOK_HTTP_REQUEST_TIMEOUT=20s
# How long in-flight requests may run after SIGTERM. Default: 20s.
NOOK_HTTP_SHUTDOWN_TIMEOUT=20s
# Largest accepted request body in bytes (max 64 MiB). Default: 1048576 (1 MiB).
NOOK_HTTP_MAX_BODY_BYTES=1048576
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For. Default: none.
NOOK_HTTP_TRUSTED_PROXIES=
# PEM certificate and key; set both to serve HTTPS (required outside development).
NOOK_HTTP_TLS_CERT_PATH=
NOOK_HTTP_TLS_KEY_PATH=

# Required. Outside development use sslmode=verify-full.
NOOK_POSTGRES_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
# Pool limits and timeouts. Defaults: 10, 1, 30m, 5m, 30s, 5s.
NOOK_POSTGRES_MAX_CONNS=10
NOOK_POSTGRES_MIN_CONNS=1
NOOK_POSTGRES_MAX_CONN_LIFETIME=30m
NOOK_POSTGRES_MAX_CONN_IDLE_TIME=5m
NOOK_POSTGRES_HEALTH_CHECK_PERIOD=30s
NOOK_POSTGRES_CONNECT_TIMEOUT=5s

# Required. Outside development use the rediss:// (TLS) scheme.
NOOK_REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}/0
# Client timeouts and pool size. Defaults: 5s, 3s, 3s, 10.
NOOK_REDIS_DIAL_TIMEOUT=5s
NOOK_REDIS_READ_TIMEOUT=3s
NOOK_REDIS_WRITE_TIMEOUT=3s
NOOK_REDIS_POOL_SIZE=10

# Outside development, allow Postgres/Redis without TLS when every host they
# name is internal (Unix socket, loopback, RFC 1918/ULA address, or a
# single-label name such as a Docker service). Logged as a warning at startup.
# Default: false.
NOOK_ALLOW_PLAINTEXT_INTERNAL=false

# --- Sign-in (OpenID Connect) ---
# Required. The provider's issuer URL. Google: https://accounts.google.com
NOOK_OIDC_ISSUER_URL=http://localhost:${DEX_PORT}/dex
# Required. OAuth client credentials registered with the provider.
NOOK_OIDC_CLIENT_ID=nook-dev
NOOK_OIDC_CLIENT_SECRET=${DEX_NOOK_CLIENT_SECRET}
# Redirect URL registered with the provider. Default: NOOK_PUBLIC_URL/auth/callback.
NOOK_OIDC_REDIRECT_URL=
# Comma-separated scopes; must include openid and email. Default: openid,email,profile.
NOOK_OIDC_SCOPES=openid,email,profile
# Label of the sign-in button. Default: single sign-on.
NOOK_OIDC_PROVIDER_NAME="Dex (development)"
# Timeout for each request to the provider. Default: 10s.
NOOK_OIDC_HTTP_TIMEOUT=10s
# Who may create an account (at least one of the two must be set):
# people whose email domain is listed (exact match, comma-separated) ...
NOOK_ALLOWED_EMAIL_DOMAINS=nook.test
# ... and these addresses, who also become instance administrators.
# Anyone else needs an open invitation to a workspace.
NOOK_BOOTSTRAP_ADMIN_EMAILS=alice@nook.test

# --- Sessions, invitations and CLI login ---
# Browser session ends after this much inactivity. Default: 24h.
NOOK_SESSION_IDLE_TIMEOUT=24h
# ... and at the latest this long after sign-in. Default: 168h (7 days).
NOOK_SESSION_ABSOLUTE_TIMEOUT=168h
# Workspace invitations stay open this long. Default: 168h.
NOOK_INVITATION_TTL=168h
# `nook login` codes expire after this long. Default: 10m.
NOOK_DEVICE_CODE_TTL=10m
# Minimum interval between CLI polls. Default: 5s.
NOOK_DEVICE_POLL_INTERVAL=5s
# Lifetime of API tokens issued to the CLI by `nook login`. Default: 2160h (90 days).
NOOK_CLI_TOKEN_TTL=2160h

# --- Worker nodes and the agent gRPC endpoint ---
# gRPC listen address for nook-agent (separate from the REST API). Default: :9443.
NOOK_GRPC_ADDR=127.0.0.1:9443
# host:port agents dial; printed in join commands and covered by the server
# certificate. Default: the NOOK_PUBLIC_URL host with the NOOK_GRPC_ADDR port.
NOOK_GRPC_PUBLIC_ADDR=127.0.0.1:9443
# More host names/IPs for the gRPC server certificate (comma-separated).
NOOK_GRPC_SERVER_NAMES=localhost
# CA bundle (certificate + private key, mode 0600), created on first start.
# Every control-plane instance must use the same file. Default:
# /var/lib/nook-server/pki/ca.pem. Development keeps it in the git-ignored .nook-dev/.
NOOK_PKI_CA_PATH=.nook-dev/pki/ca.pem
# Lifetime of node client certificates; agents renew after two thirds. Default: 168h.
NOOK_NODE_CERT_TTL=168h
# Default lifetime of join tokens (at most 168h). Default: 1h.
NOOK_JOIN_TOKEN_TTL=1h
# How often agents send heartbeats; a node is suspect after 3 missed
# intervals. Default: 5s.
NOOK_HEARTBEAT_INTERVAL=5s
# A node without heartbeats for this long is dead. Default: 30s.
NOOK_NODE_DEAD_AFTER=30s
# How often heartbeats are copied from Redis to Postgres. Default: 30s.
NOOK_HEARTBEAT_PERSIST_INTERVAL=30s
# How often the leader evaluates node health. Default: 1s.
NOOK_FAILURE_DETECTOR_INTERVAL=1s
# How often followers try to become leader (bounds failover time). Default: 2s.
NOOK_LEADER_RETRY_INTERVAL=2s
# Default time an agent gets to answer a command such as inspect. Default: 15s.
NOOK_NODE_COMMAND_TIMEOUT=15s

# --- nook-agent (worker nodes) ---
# The agent runs on worker machines and is configured there, not in this
# file. `nook-agent run` reads:
#   NOOK_AGENT_STATE_DIR             node identity (0700 dir, 0600 files); default /var/lib/nook-agent
#                                    (`nook-agent join --state-dir` overrides it for joining)
#   NOOK_AGENT_HEALTH_ADDR           /healthz, /readyz, /metrics; loopback only; default 127.0.0.1:9101
#   NOOK_AGENT_RECONNECT_MIN / _MAX  reconnect backoff bounds (full jitter); default 1s / 60s
#   NOOK_AGENT_RENEW_CHECK_INTERVAL  how often certificate expiry is checked; default 10m
#   NOOK_AGENT_BUILD_SLOTS           builds run at once (0: no builds); default 2
#   NOOK_AGENT_BUILDKIT_IMAGE        rootless BuildKit image, pinned by digest
#   NOOK_AGENT_BUILD_NETWORK         network build containers join; created by the agent and
#                                    always egress-filtered; default nook-builds
#   NOOK_AGENT_BUILD_HOSTS           name=ip entries for builds (a registry not in DNS)
#   NOOK_AGENT_BUILD_PROXY           pass the Docker engine's HTTP proxy to builds; default false
#                                    (the proxy must then be in NOOK_AGENT_BUILD_EGRESS_ALLOW)
#   NOOK_AGENT_BUILD_MAX_CONTEXT_BYTES  extracted build context limit; default 2 GiB
#   NOOK_AGENT_ADVERTISE_ADDR        required: the node's private IP; app ports are published
#                                    only there (development: 127.0.0.1)
#   NOOK_AGENT_REGISTRY_PULL_ADDR    registry host:port as the agent reaches it, if different
#                                    from NOOK_REGISTRY_ADDR (development: localhost:5000)
#   NOOK_AGENT_CRASH_LIMIT / _WINDOW crashes within the window that make an instance
#                                    "crashed" (no more restarts); default 5 / 10m
#   NOOK_AGENT_RESTART_BACKOFF_MIN / _MAX  restart delay after a crash (doubles); default 1s / 5m
#   NOOK_AGENT_EGRESS_FILTER         install the egress firewall; default true
#   NOOK_AGENT_FIREWALL_IMAGE        iptables helper image, pinned by digest
#   NOOK_AGENT_FIREWALL_CHAIN        prefix of the agent's iptables chains; default NOOK
#   NOOK_AGENT_BUILD_EGRESS_ALLOW    private IPs/CIDRs builds may reach (the registry)
#   NOOK_AGENT_EGRESS_BLOCK          more blocked IPs/CIDRs (other nodes' public addresses)
#   NOOK_LOG_LEVEL                   debug|info|warn|error; default info
#   DOCKER_HOST and DOCKER_*         standard Docker client settings; default the local socket
# `nook-agent join` also reads NOOK_JOIN_TOKEN, so the token can stay out
# of the process list and shell history.
#
# `make run-agent` runs an agent on this machine for development with the
# settings below. Builds run on the filtered nook-builds network as in
# production; they reach the dev registry by its fixed address on the
# compose network, which the firewall allows. Apps are published on
# 127.0.0.1, and the agent pulls images from the registry's local port.
NOOK_AGENT_STATE_DIR=.nook-dev/agent
NOOK_AGENT_HEALTH_ADDR=127.0.0.1:9101
NOOK_AGENT_ADVERTISE_ADDR=127.0.0.1
NOOK_AGENT_REGISTRY_PULL_ADDR=localhost:${REGISTRY_PORT}
NOOK_AGENT_BUILD_HOSTS=registry=172.31.250.10
NOOK_AGENT_BUILD_EGRESS_ALLOW=172.31.250.10

# --- Apps, builds and the image registry ---
# S3-compatible object storage. Development uses MinIO's root account;
# production uses a key limited to the bucket. TLS (https://) is required
# outside development.
NOOK_S3_ENDPOINT=http://127.0.0.1:${MINIO_API_PORT}
# Base URL put into presigned URLs for the CLI and agents. Default: NOOK_S3_ENDPOINT.
NOOK_S3_PRESIGN_ENDPOINT=
# Region in signatures ("auto" for Cloudflare R2). Default: us-east-1.
NOOK_S3_REGION=us-east-1
NOOK_S3_BUCKET=nook
NOOK_S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
NOOK_S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
# Bound on each storage call. Default: 30s.
NOOK_S3_REQUEST_TIMEOUT=30s
# Registry host:port as build containers and nodes reach it; images are
# referenced as <this>/<workspace-id>/<app-id>@sha256:...
NOOK_REGISTRY_ADDR=registry:5000
# Registry API as the control plane reaches it (always https). Default: https://NOOK_REGISTRY_ADDR.
NOOK_REGISTRY_URL=https://localhost:${REGISTRY_PORT}
# Must match auth.token.service and .issuer in the registry config. Defaults: nook-registry, nook.
NOOK_REGISTRY_SERVICE=nook-registry
NOOK_REGISTRY_TOKEN_ISSUER=nook
# Shared with the registry's garbage-collection job (at least 16 characters).
NOOK_REGISTRY_GC_SECRET=__GENERATED_SECRET__
# Bound on each registry API call. Default: 30s.
NOOK_REGISTRY_REQUEST_TIMEOUT=30s
# Largest source archive accepted (bytes). Default: 209715200 (200 MB).
NOOK_SOURCE_MAX_BYTES=209715200
# Lifetime of presigned upload URLs. Default: 15m.
NOOK_UPLOAD_URL_TTL=15m
# Default quotas; instance admins override them per workspace. Defaults: 20 apps, 2 builds.
NOOK_QUOTA_MAX_APPS=20
NOOK_QUOTA_MAX_CONCURRENT_BUILDS=2
# Highest memory (MB) and CPU (millicores) an app may request. Defaults: 4096, 4000.
NOOK_APP_MAX_MEMORY_MB=4096
NOOK_APP_MAX_CPU_MILLICORES=4000
# Build limits: wall time, memory (MB), CPU (millicores), log size (bytes).
NOOK_BUILD_TIMEOUT=15m
NOOK_BUILD_MEMORY_MB=2048
NOOK_BUILD_CPU_MILLICORES=2000
NOOK_BUILD_MAX_LOG_BYTES=5242880
# A deployment that finds no build capacity for this long fails. Default: 30m.
NOOK_BUILD_QUEUE_TIMEOUT=30m
# Attempts after infrastructure failures (user build errors never retry). Default: 3.
NOOK_BUILD_MAX_ATTEMPTS=3
# A job left unacknowledged this long by a silent instance is reclaimed. Default: 60s.
NOOK_BUILD_CLAIM_TIMEOUT=60s
# A build its agent never acknowledged within this time is retried. Default: 30s.
NOOK_BUILD_ACCEPT_TIMEOUT=30s
# How often a deployment's owner re-checks it. Default: 2s.
NOOK_BUILD_TICK_INTERVAL=2s
# Built images kept per app. Default: 10.
NOOK_IMAGE_RETENTION_COUNT=10
# How long source archives and build logs are kept. Default: 720h (30 days).
NOOK_BUILD_ARTIFACT_RETENTION=720h
# How often the leader enforces retention. Default: 5m.
NOOK_BUILD_JANITOR_INTERVAL=5m

# --- Running apps ---
# Master key that encrypts app environment variables (AES-256-GCM). The
# file holds "<version>:<base64 key>" lines; `make dev-up` creates it with
# `nook-server secrets init`. Rotate with `nook-server secrets add-key` and
# `nook-server secrets rotate-key` (see docs/decisions).
NOOK_SECRETS_KEY_FILE=.nook-dev/secrets.key
# Memory quota (MB) of a workspace's running apps. Default: 8192.
NOOK_QUOTA_MAX_MEMORY_MB=8192
# Longest startup (health check) timeout an app may set in nook.toml. Default: 10m.
NOOK_APP_MAX_STARTUP_TIMEOUT=10m
# Memory (MB) and CPU (millicores) per node kept free of apps. Defaults: 512, 250.
NOOK_SCHEDULER_NODE_RESERVED_MEMORY_MB=512
NOOK_SCHEDULER_NODE_RESERVED_MILLICORES=250
# How long the previous version keeps serving after a new one is live. Default: 10s.
NOOK_ROLLOUT_DRAIN=10s
# Time a node may take to pull an image before the startup timeout counts. Default: 10m.
NOOK_ROLLOUT_PULL_TIMEOUT=10m
# Limits of one `nook logs` request: bytes and duration. Defaults: 10485760, 1h.
NOOK_APP_LOGS_MAX_BYTES=10485760
NOOK_APP_LOGS_MAX_DURATION=1h

# Per-dependency timeout for GET /readyz; below the request timeout. Default: 2s.
NOOK_READINESS_TIMEOUT=2s
# How long startup waits for Postgres, Redis and the OIDC provider. Default: 30s.
NOOK_STARTUP_TIMEOUT=30s
# Bound on waiting for the migration lock plus applying migrations. Default: 2m.
NOOK_MIGRATION_TIMEOUT=2m
